# Copy to infrastructure/.env (make init does this), then CHANGE EVERY PASSWORD below.
# These are placeholders, not real credentials. infrastructure/.env is git-ignored.
LDAP_ADMIN_PASSWORD=change-me-ldap-admin
LAB_USER_PASSWORD=change-me-lab-user
LDAP_KEYCLOAK_PASSWORD=change-me-keycloak-svc
LDAP_SQUID_PASSWORD=change-me-squid-svc
LDAP_CONSOLE_PASSWORD=change-me-console-svc
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
AUTH_ENABLED=true
# Set to your Mac's LAN/host-only IP so the Windows VM can reach WireGuard
WG_PUBLIC_ENDPOINT=172.30.0.10
# Break/fix: e.g. "+2h" to skew the SAML SP clock (TKT-002)
SAML_APP_FAKETIME_OFFSET=
